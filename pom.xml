<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.bytezone</groupId>
  <artifactId>dm3270</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>dm3270</name>
  <description>3270 terminal emulator</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <javafx.version>21.0.7</javafx.version>
    <main.class>com.bytezone.dm3270.application.Launcher</main.class>
    <junit.version>5.12.2</junit.version>
    <jacoco.version>0.8.13</jacoco.version>
    <pitest.version>1.20.1</pitest.version>
    <pitest.junit5.version>1.2.3</pitest.junit5.version>

    <!--
      Preenchida pelo agente do JaCoCo em tempo de build. O valor default vazio
      mantem `mvn surefire:test` funcionando quando o agente nao roda.
    -->
    <jacoco.argLine/>
    <archunit.version>1.3.0</archunit.version>
    <slf4j.version>2.0.17</slf4j.version>
    <logback.version>1.5.18</logback.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <!-- Cross-platform JavaFX binaries -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>win</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>mac</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>linux</classifier>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.49.1.0</version>
    </dependency>

    <!-- Logging: SLF4J (fachada) + Logback (implementação) -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
    </dependency>

    <!-- Testes -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!--
      Regras de arquitetura como teste. O baseline congelado vive em
      test/archunit-baseline e e versionado: violacao nova quebra a build,
      violacao ja existente nao.
    -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src</sourceDirectory>
    <testSourceDirectory>test</testSourceDirectory>

    <resources>
      <resource>
        <directory>src</directory>
        <includes>
          <include>**/*.txt</include>
          <include>**/*.xml</include>
        </includes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <!-- as classes de protocolo usam assert para validar os buffers -->
          <enableAssertions>true</enableAssertions>
          <!-- @{...} adia a resolucao ate o agente do JaCoCo ter preenchido a propriedade -->
          <argLine>@{jacoco.argLine} -Dfile.encoding=UTF-8 -Djava.awt.headless=true</argLine>
        </configuration>
      </plugin>

      <!-- Cobertura de codigo: relatorio em target/site/jacoco/index.html -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <propertyName>jacoco.argLine</propertyName>
        </configuration>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <!-- na fase test (e nao verify) para que `mvn test` ja gere o relatorio -->
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Mutation testing. Nao roda no ciclo padrao (e caro); invoque com
        `mvn test-compile pitest:mutationCoverage`.

        targetClasses lista apenas os pacotes que possuem testes: apontar o PIT
        para a camada JavaFX geraria milhares de mutantes sem cobertura e
        afogaria o sinal util.
      -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest.junit5.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>com.bytezone.dm3270.utilities.Dm3270Utility</param>
            <param>com.bytezone.dm3270.utilities.FileSaver</param>
            <param>com.bytezone.dm3270.orders.*</param>
            <param>com.bytezone.dm3270.attributes.*</param>
            <param>com.bytezone.dm3270.commands.*</param>
            <param>com.bytezone.dm3270.buffers.*</param>
            <param>com.bytezone.dm3270.telnet.*</param>
            <param>com.bytezone.dm3270.extended.*</param>
            <param>com.bytezone.dm3270.structuredfields.*</param>
            <param>com.bytezone.dm3270.replyfield.*</param>
            <param>com.bytezone.dm3270.filetransfer.*</param>
            <param>com.bytezone.dm3270.database.*</param>
            <param>com.bytezone.dm3270.session.SessionReader</param>
            <param>com.bytezone.dm3270.streams.TelnetState</param>
            <param>com.bytezone.dm3270.streams.TerminalServer</param>
            <param>com.bytezone.dm3270.streams.TelnetSocket</param>
            <param>com.bytezone.dm3270.streams.SslContextFactory</param>
            <param>com.bytezone.dm3270.plugins.PluginData</param>
            <param>com.bytezone.dm3270.plugins.PluginField</param>
            <param>com.bytezone.dm3270.plugins.ScreenLocation</param>
            <!--
              O modelo de tela, que agora vive no pacote screen. Estas classes deixaram de
              depender do JavaFX na onda de desacoplamento e passaram a ter teste:
              ScreenPositionDrawingTest, ScreenContextPoolingTest, PaletteFidelityTest e
              HeadlessProcessingTest. FxPalette continua em display, porque converter para
              javafx.scene.paint.Color e justamente o trabalho dela.

              Listadas uma a uma, e nao como screen.*, de proposito: Cursor, Field,
              DisplayScreen e as portas ainda nao tem teste proprio. E de display so entra a
              FxPalette - Screen, HistoryScreen, FieldManager, ScreenWatcher, ScreenPacker,
              HistoryManager, FontManager e ScreenSelection continuam sem teste e produziriam
              milhares de mutantes sobreviventes, afogando o sinal util. Conforme a onda 3
              decompor Screen, as partes entram aqui.

              Cursor entrou agora que tem o CursorTest: 20 testes que congelam movimento,
              volta na tela, avisos aos ouvintes, navegacao por campo e visibilidade.
            -->
            <param>com.bytezone.dm3270.screen.ScreenDimensions</param>
            <param>com.bytezone.dm3270.screen.ScreenPosition</param>
            <param>com.bytezone.dm3270.screen.ScreenContext</param>
            <param>com.bytezone.dm3270.screen.ContextManager</param>
            <param>com.bytezone.dm3270.screen.Cursor</param>
            <param>com.bytezone.dm3270.screen.Pen</param>
            <param>com.bytezone.dm3270.screen.PenType1</param>
            <param>com.bytezone.dm3270.screen.FontMetrics</param>
            <param>com.bytezone.dm3270.screen.ScreenOption</param>
            <param>com.bytezone.dm3270.display.FxPalette</param>
            <param>com.bytezone.reporter.record.*</param>
            <param>com.bytezone.reporter.text.*</param>
            <param>com.bytezone.reporter.reports.*</param>
            <param>com.bytezone.reporter.file.MainframeFile</param>
            <param>com.bytezone.reporter.file.RecordTester</param>
            <param>com.bytezone.reporter.file.ReportData</param>
            <param>com.bytezone.reporter.file.ReportTester</param>
            <param>com.bytezone.reporter.file.TextTester</param>
          </targetClasses>
          <!--
            Excluidos por serem testes de integracao com socket ou thread: o PIT roda
            cada mutante num processo proprio e esses casos ficariam pendurados no
            timeout, inflando o tempo total sem produzir sinal util.
          -->
          <excludedTestClasses>
            <param>com.bytezone.dm3270.streams.TerminalServerTest</param>
            <param>com.bytezone.dm3270.streams.TelnetSocketTest</param>
          </excludedTestClasses>
          <targetTests>
            <param>com.bytezone.dm3270.*Test</param>
            <param>com.bytezone.reporter.*Test</param>
          </targetTests>
          <outputFormats>
            <param>HTML</param>
            <param>XML</param>
            <param>CSV</param>
          </outputFormats>
          <!-- caminho estavel: target/pit-reports/index.html -->
          <timestampedReports>false</timestampedReports>
          <!-- reaproveita a analise anterior enquanto o target nao for limpo -->
          <withHistory>true</withHistory>
          <threads>4</threads>
          <jvmArgs>
            <jvmArg>-ea</jvmArg>
            <jvmArg>-Djava.awt.headless=true</jvmArg>
          </jvmArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
          <jvmArgs>--enable-native-access=javafx.graphics</jvmArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${main.class}</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>